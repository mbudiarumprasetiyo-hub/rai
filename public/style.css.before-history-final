/* ==============================
   CHAT IMAGE
   ============================== */

.chat-image {
    display: block;
    width: auto;
    max-width: min(240px, 100%);
    max-height: 240px;
    margin: 6px 0 8px;
    border-radius: 10px;
    object-fit: contain;
    border: 1px solid rgba(0, 255, 136, 0.35);
}


.copy-btn {
    display: block;
    margin-top: 8px;
    padding: 5px 9px;
    border: 1px solid rgba(0, 255, 136, 0.35);
    border-radius: 5px;
    background: rgba(0, 255, 136, 0.05);
    color: #00ff88;
    font-size: 10px;
    font-family: inherit;
    cursor: pointer;
    transition: 0.2s ease;
}

.copy-btn:hover {
    background: rgba(0, 255, 136, 0.15);
}

.copy-btn:active {
    transform: scale(0.96);
}


.message-action {
    display: inline-block;
    margin-top: 8px;
    margin-right: 5px;
    padding: 5px 9px;
    border: 1px solid rgba(0, 255, 136, 0.35);
    border-radius: 5px;
    background: rgba(0, 255, 136, 0.05);
    color: #00ff88;
    font-size: 10px;
    font-family: inherit;
    cursor: pointer;
    transition: 0.2s ease;
}

.message-action:hover {
    background: rgba(0, 255, 136, 0.15);
}

.message-action:active {
    transform: scale(0.96);
}


.retry-btn {
    border-color: rgba(255, 180, 0, 0.4);
}


/* ==============================
   RAI CHAT HISTORY
   ============================== */

.history-panel {
    display: none;
    position: absolute;
    top: 70px;
    right: 15px;
    width: min(360px, calc(100% - 30px));
    max-height: 70vh;
    overflow-y: auto;
    z-index: 5000;
    padding: 12px;
    border: 1px solid rgba(0, 255, 136, 0.35);
    border-radius: 10px;
    background: rgba(5, 12, 10, 0.97);
    box-shadow: 0 0 25px rgba(0, 255, 136, 0.12);
}

.history-panel.active {
    display: block;
}

.history-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    color: #00ff88;
    font-size: 12px;
    font-weight: bold;
}

.history-title button {
    padding: 5px 8px;
    border: 1px solid rgba(0, 255, 136, 0.3);
    border-radius: 5px;
    background: rgba(0, 255, 136, 0.05);
    color: #00ff88;
    font-size: 9px;
    cursor: pointer;
}

.history-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.history-item {
    width: 100%;
    box-sizing: border-box;
    padding: 9px;
    border: 1px solid rgba(0, 255, 136, 0.18);
    border-radius: 7px;
    background: rgba(0, 255, 136, 0.03);
    color: #d8fff0;
    text-align: left;
    cursor: pointer;
}

.history-item:hover {
    background: rgba(0, 255, 136, 0.09);
}

.history-item-title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 11px;
}

.history-item-meta {
    margin-top: 4px;
    color: rgba(216, 255, 240, 0.5);
    font-size: 9px;
}

.history-empty {
    padding: 15px 5px;
    color: rgba(216, 255, 240, 0.45);
    text-align: center;
    font-size: 10px;
}

