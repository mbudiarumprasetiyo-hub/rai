body {
    max-width: 100%;
    overflow-x: hidden;
}

main {
    max-width: 100%;
}

.dashboard,
.chat-panel,
.sidebar {
    min-width: 0;
    max-width: 100%;
}

.chat-panel {
    overflow: hidden;
}

.chat {
    min-width: 0;
    overflow-x: hidden;
}

.input-area {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 6px;
}

.input-area textarea {
    min-width: 0;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
}

#imageBtn,
#galleryBtn,
#sendBtn {
    flex: 0 0 43px;
    width: 43px;
    min-width: 43px;
    height: 43px;
    box-sizing: border-box;
}

#imageBtn,
#galleryBtn {
    display: flex;
    align-items: center;
    justify-content: center;
}

#imagePreview {
    position: relative;
    left: auto;
    bottom: auto;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    margin: 6px 0;
}

.selected-image {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    box-sizing: border-box;
}

.selected-image img {
    display: block;
    max-width: 180px;
    max-height: 150px;
    object-fit: contain;
}

@media (max-width: 450px) {

    main {
        width: 94%;
        max-width: 94%;
    }

    .dashboard {
        width: 100%;
    }

    .chat-panel {
        width: 100%;
        min-width: 0;
    }

    .input-area {
        gap: 4px;
    }

    #imageBtn,
    #galleryBtn,
    #sendBtn {
        flex: 0 0 40px;
        width: 40px;
        min-width: 40px;
        height: 40px;
    }

    .input-area textarea {
        font-size: 13px;
    }

    .selected-image img {
        max-width: 150px;
        max-height: 120px;
    }
}


