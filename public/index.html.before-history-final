<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAI — Republik Of AI</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<canvas id="matrix"></canvas>
<div class="scanlines"></div>

<div id="boot">
    <div class="boot-box">
        <div class="boot-logo">RAI</div>
        <div id="bootText"></div>
        <div class="loading">
            <span id="loadingBar"></span>
        </div>
        <p id="bootStatus">INITIALIZING SYSTEM...</p>
    </div>
</div>

<div class="app">

    <header class="topbar">
        <div class="brand">
            <div class="logo-glitch" data-text="RAI">RAI</div>
            <div class="brand-info">
                <strong>REPUBLIK OF AI</strong>
                <span>NEURAL INTELLIGENCE SYSTEM</span>
            </div>
        </div>

        <div class="system-status">
            <span class="status-dot"></span>
            <span>ONLINE</span>
        </div>
    </header>

    <main>

        <section class="hero">

            <div class="hero-content">

                <div class="terminal-label">
                    <span>DEVELOPER</span>:~Tyo.exe
                </div>

                <h1>
                    WELCOME TO
                    <span>RAI</span>
                </h1>

                <p>
                    Republik Of AI — pusat kecerdasan buatan
                    generasi baru.
                </p>

                <div class="hero-buttons">
                    <button onclick="focusChat()">START CHAT</button>
                    <button class="secondary" onclick="showSystem()">SYSTEM INFO</button>
                </div>

            </div>

            <div class="core">
                <div class="core-ring ring1"></div>
                <div class="core-ring ring2"></div>
                <div class="core-ring ring3"></div>

                <div class="core-center">
                    <span>RAI</span>
                    <small>AI CORE</small>
                </div>
            </div>

        </section>

        <section class="dashboard">

            <aside class="sidebar">

                <div class="side-title">
                    <span>◈</span> SYSTEM
                </div>

                <div class="system-card">
                    <span>CPU</span>
                    <strong id="cpu">37%</strong>
                    <div class="progress">
                        <i id="cpuBar"></i>
                    </div>
                </div>

                <div class="system-card">
                    <span>MEMORY</span>
                    <strong id="memory">61%</strong>
                    <div class="progress">
                        <i id="memoryBar"></i>
                    </div>
                </div>

                <div class="system-card">
                    <span>NEURAL CORE</span>
                    <strong class="green">ACTIVE</strong>
                </div>

                <div class="side-title">
                    <span>◈</span> COMMANDS
                </div>

                <button class="side-button" onclick="setPrompt('Jelaskan apa itu AI')">
                    <span>01</span> ASK AI
                </button>

                <button class="side-button" onclick="setPrompt('Buatkan kode JavaScript')">
                    <span>02</span> CODE
                </button>

                <button class="side-button" onclick="setPrompt('Bantu saya belajar')">
                    <span>03</span> LEARN
                </button>

                <button class="side-button" onclick="clearChat()">
                    <span>04</span> CLEAR
                </button>

            </aside>

            <section class="chat-panel">

                <div class="chat-header">
                    <div>
                        <strong>RAI TERMINAL</strong>
                        <span>ENCRYPTED NEURAL CHANNEL</span>
                    </div>

                    <div class="header-actions">
                        <button onclick="toggleHistory()">HISTORY</button>
                        <button onclick="clearChat()">CLR</button>
                    </div>
                </div>

                <div id="historyPanel" class="history-panel">
                    <div class="history-title">
                        CHAT HISTORY
                        <button onclick="toggleHistory()">CLOSE</button>
                    </div>

                    <div id="historyList" class="history-list"></div>
                </div>

                <div id="chat" class="chat">

                    <div class="message ai">
                        <div class="avatar">RAI</div>

                        <div class="bubble">
                            <div class="message-name">
                                RAI CORE
                            </div>

                            <p>
                                Sistem RAI berhasil di install
                                   hai kawan 👋 
                                 Halo selamat datang di RAI  
                                 Saya RAI siap membantu hari mu.
                            </p>

                            <small>
                                SYSTEM READY // 00:00:01
                            </small>
                        </div>
                    </div>

                </div>

                <div class="typing" id="typing">
                    <span></span>
                    <span></span>
                    <span></span>
                    RAI sedang berpikir...
                </div>

                <!-- RAI CAMERA -->
<input
    id="cameraInput"
    type="file"
    accept="image/*"
    capture="environment"
    hidden
>

<input
    id="galleryInput"
    type="file"
    accept="image/*"
    hidden
>

<div class="input-area">

                    

                    <button
        id="galleryBtn"
        type="button"
        title="Pilih Foto"
        onclick="openGallery()"
    >🖼️</button>

    <button
        id="imageBtn"
        type="button"
        title="Foto Soal"
        onclick="openCamera()"
    >📷</button>

                    <span id="imageMode">
                        FOTO / SOAL
                    </span>

                    <div id="imagePreview"></div>

                    <div class="input-prefix">
                        &gt;_
                    </div>

                    <textarea
                        id="message"
                        placeholder="Masukkan perintah atau pertanyaan..."
                        rows="1"
                    ></textarea>

                    <button id="sendBtn" type="button" onclick="sendMessage()">
                        SEND
                    </button>

                </div>

                <div class="input-info">
                    ENTER = SEND &nbsp; // &nbsp;
                    SHIFT + ENTER = NEW LINE
                </div>

            </section>

        </section>

    </main>

    <footer>
        <span>RAI v1.0</span>
        <span>REPUBLIK OF AI</span>
        <span>NEURAL SYSTEM ONLINE</span>
    </footer>

</div>

<div id="systemModal" class="modal">

    <div class="modal-box">

        <button class="close" onclick="closeSystem()">×</button>

        <div class="modal-title">
            SYSTEM INFORMATION
        </div>

        <div class="terminal-output">
            <p>[OK] RAI CORE .............. ONLINE</p>
            <p>[OK] NEURAL NETWORK ........ ACTIVE</p>
            <p>[OK] ENCRYPTION ............ ENABLED</p>
            <p>[OK] MATRIX ENGINE ......... RUNNING</p>
            <p>[OK] CHAT INTERFACE ........ READY</p>
            <p>[OK] TERMUX SERVER ......... CONNECTED</p>
            <br>
            <p class="green">
                SYSTEM STATUS: OPERATIONAL
            </p>
        </div>

    </div>

</div>

<script src="script.js?v=20260914"></script>

</body>
</html>
